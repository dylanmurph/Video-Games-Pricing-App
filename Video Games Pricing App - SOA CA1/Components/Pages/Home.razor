@page "/"
@using GameDealFinder.Models

<PageTitle>Game Deal Finder</PageTitle>

<h1>Game Deal Finder</h1>

<form class="d-flex gap-2 my-3" @onsubmit="SearchAsync">
    <input class="form-control" placeholder="Search for a game, e.g. Call of Duty" @bind="query" />
    <button class="btn btn-primary" type="submit" disabled="@loading">Search</button>
</form>

@if (errorMessage is not null)
{
    <div class="alert alert-warning">@errorMessage</div>
}
else if (loading)
{
    <p>Searching…</p>
}
else if (games is { Count: 0 })
{
    <p>No games found.</p>
}
else if (games is not null)
{
    @if (priceWarning is not null)
    {
        <div class="alert alert-info">@priceWarning</div>
    }

    <ul class="list-group">
        @foreach (var game in games)
        {
            @if (FindDeal(game) is GameDeal deal)
            {
                <li class="list-group-item d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(deal.ThumbnailUrl))
                    {
                        <img src="@deal.ThumbnailUrl" alt="" class="rounded flex-shrink-0"
                             style="width: 120px; height: 45px; object-fit: cover;" loading="lazy" />
                    }
                    else
                    {
                        <div class="bg-secondary-subtle rounded flex-shrink-0" style="width: 120px; height: 45px;" aria-hidden="true"></div>
                    }

                    <div class="flex-grow-1">
                        <a href="game/@game.Id?deal=@deal.GameId" class="fw-semibold">@game.Name</a>
                        <div class="text-muted small">
                            @(game.Released?.Year.ToString() ?? "TBA") | @game.Rating.ToString("0.0")
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-secondary-subtle rounded flex-shrink-0" style="width: 24px; height: 24px;" aria-hidden="true"></div>
                        <div>
                            <div class="text-muted small">Store</div>
                            <div class="fw-semibold">@deal.StoreName</div>
                        </div>
                    </div>

                    <div class="text-end">
                        <div class="text-muted small">Lowest price</div>
                        <div class="fs-5 fw-bold">$@deal.CheapestPrice.ToString("0.00")</div>
                    </div>
                </li>
            }
        }
    </ul>
}