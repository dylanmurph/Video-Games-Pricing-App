@page "/api-test"

<PageTitle>API test</PageTitle>
<h1>API test</h1>

<div class="d-flex gap-2 mb-3">
    <input class="form-control" @bind="title" />
    <button class="btn btn-primary" @onclick="LoadAsync" disabled="@loading">Call both APIs</button>
</div>

@if (loading)
{
    <p>Loading…</p>
}

<h2>RAWG (game data)</h2>
@if (rawgError)
{
    <p>Failed to get games from RAWG</p>
}
else
{
    <pre style="max-height: 400px; overflow: auto;">@rawgJson</pre>
}

<h2>CheapShark (prices)</h2>
@if (cheapSharkError)
{
    <p>Failed to get prices from CheapShark</p>
}
else
{
    <pre style="max-height: 400px; overflow: auto;">@cheapSharkJson</pre>
}